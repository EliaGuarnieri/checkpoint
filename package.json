{
  "name": "checkpoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/db.ts migrate",
    "db:check": "node --import tsx scripts/db.ts check",
    "db:migrate:supabase": "node --import tsx scripts/supabase-db.ts migrate",
    "db:check:supabase": "node --import tsx scripts/supabase-db.ts check",
    "setup": "bash scripts/setup.sh",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "5.103.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "effect": "3.22.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@next/env": "16.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "oxfmt": "^0.70.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.19.0"
}
