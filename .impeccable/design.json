      "html": "<input class=\"ds-search\" placeholder=\"Cerca un gioco o aggiungilo…\" aria-label=\"Cerca un gioco\">",
      "css": ".ds-search{height:2.5rem;width:100%;padding:0 .75rem;border:1px solid var(--input);border-radius:var(--radius-lg);background:var(--card);color:var(--foreground);font:400 .875rem Geist,sans-serif;transition:border-color .2s,box-shadow .2s}.ds-search::placeholder{color:var(--muted-foreground)}.ds-search:hover{border-color:var(--ring)}.ds-search:focus-visible{outline:2px solid var(--ring);outline-offset:2px;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge-secondary-dark",
      "description": "Stato leggibile sopra la cover senza occupare l'accento principale.",
      "html": "<span class=\"ds-badge\">In corso</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;height:1.25rem;padding:0 .5rem;border-radius:9999px;background:var(--secondary);color:var(--secondary-foreground);font:500 .75rem Geist,sans-serif;white-space:nowrap}.ds-badge:hover{filter:brightness(.95)}.ds-badge:focus-visible{outline:2px solid var(--ring);outline-offset:2px;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Library Card",
      "kind": "card",
      "refersTo": "library-card-dark",
      "description": "Cover ampia, metadati brevi e voto personale.",
      "html": "<a class=\"ds-card\" href=\"#\"><div class=\"ds-card-cover\">Copertina</div><div class=\"ds-card-content\"><small>2020 · Action</small><strong>Hades</strong><span>Supergiant Games</span><footer>9/10 · Il tuo voto</footer></div></a>",
      "css": ".ds-card{display:block;overflow:hidden;border:1px solid var(--border);border-radius:var(--radius-xl);background:var(--card);color:var(--card-foreground);text-decoration:none;transition:transform .3s,box-shadow .3s}.ds-card-cover{display:grid;place-items:center;aspect-ratio:1.55;background:var(--secondary);color:var(--secondary-foreground);font:600 1.25rem Geist,sans-serif}.ds-card-content{display:grid;gap:.375rem;padding:1.25rem;font:400 .875rem Geist,sans-serif}.ds-card-content small,.ds-card-content span{color:var(--muted-foreground)}.ds-card-content strong{margin-top:.5rem;font-size:1.5rem;line-height:1.25}.ds-card-content footer{margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border);font-size:.75rem}.ds-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-xl)}.ds-card:focus-visible{outline:2px solid var(--ring);outline-offset:2px;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}@media(prefers-reduced-motion:reduce){.ds-card:hover{transform:none}}"
    },
