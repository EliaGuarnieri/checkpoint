      "css": ".ds-nav{display:flex;align-items:center;gap:2rem;padding:.75rem 1rem;border-bottom:1px solid var(--border);background:var(--background);color:var(--foreground);font-family:Geist,sans-serif}.ds-nav-brand{font-size:1.125rem;font-weight:600;letter-spacing:-.025em}.ds-nav-search{flex:1;max-width:28rem;padding:.625rem;border:1px solid var(--input);border-radius:var(--radius-lg);background:var(--card);color:var(--muted-foreground);font-size:.875rem}.ds-nav-search:hover{border-color:var(--ring)}.ds-nav:focus-visible{outline:2px solid var(--ring);outline-offset:2px;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
