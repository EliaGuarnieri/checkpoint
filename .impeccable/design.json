      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary-dark",
      "description": "Azione principale compatta; i token CSS seguono il tema attivo.",
      "html": "<button class=\"ds-btn-primary\">Aggiungi un gioco</button>",
      "css": ".ds-btn-primary{height:2rem;padding:0 .625rem;border:1px solid transparent;border-radius:var(--radius-lg);background:var(--primary);color:var(--primary-foreground);font:500 .875rem Geist,sans-serif;transition:background .2s,transform .2s}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
