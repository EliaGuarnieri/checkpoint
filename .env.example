# Local defaults: pnpm setup starts this database with Docker Compose.
DATABASE_URL=postgresql://checkpoint:checkpoint@localhost:5433/checkpoint
# Local migrations use DATABASE_URL when this value is blank.
# For Supabase: transaction pooler (6543) above, direct/session (5432) below.
DATABASE_MIGRATION_URL=
# Blank selects the offline demo catalog only with the project database.
RAWG_API_KEY=
