{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error"
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y",
    "effecttsgo",
    "nextjs"
  ],
  "ignorePatterns": [
    ".agents/**",
    ".next/**",
    "build/**",
    "docs/screenshots/**",
    "next-env.d.ts",
    "node_modules/**",
    "out/**"
  ],
  "overrides": [
    {
      "files": ["src/components/ui/{field,label,spinner}.tsx"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
